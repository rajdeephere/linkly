# Copy to .env.local for `next dev`. The edge middleware (middleware.ts) reads these.

# Vercel KV — locally the SRH proxy over linkly-redis (infra/docker-compose.yml).
# On Vercel these come from the KV integration instead.
KV_REST_API_URL=http://localhost:8079
KV_REST_API_TOKEN=devtoken

# Origin resolver (apps/resolver) the edge calls on a cache miss / for click ingest.
RESOLVER_URL=http://localhost:8082

# Management API base for the dashboard's /api/* proxy (see next.config.mjs).
API_URL=http://localhost:8081
